{
  "id": "anima_t2i",
  "version": 1,
  "requires": [
    "UNETLoader",
    "CLIPLoader",
    "VAELoader",
    "CLIPTextEncode",
    "EmptyLatentImage",
    "KSampler",
    "VAEDecode",
    "SaveImage",
    "LoraLoaderModelOnly"
  ],
  "nodes": {
    "1": {
      "type": "UNETLoader",
      "inputs": {
        "unet_name": "anima-base-v1.0.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen_3_06b_base.safetensors",
        "type": "stable_diffusion",
        "device": "default"
      }
    },
    "3": {
      "type": "VAELoader",
      "inputs": {
        "vae_name": "qwen_image_vae.safetensors"
      }
    },
    "6": {
      "type": "CLIPTextEncode",
      "inputs": {
        "text": "{{prompt}}",
        "clip": [
          "2",
          0
        ]
      }
    },
    "7": {
      "type": "CLIPTextEncode",
      "inputs": {
        "text": "{{negative}}",
        "clip": [
          "2",
          0
        ]
      }
    },
    "8": {
      "type": "EmptyLatentImage",
      "inputs": {
        "width": "{{width}}",
        "height": "{{height}}",
        "batch_size": 1
      }
    },
    "10": {
      "type": "VAEDecode",
      "inputs": {
        "samples": [
          "9",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "11": {
      "type": "SaveImage",
      "inputs": {
        "images": [
          "10",
          0
        ],
        "filename_prefix": "{{prefix}}"
      }
    }
  },
  "sampler": {
    "node": "9",
    "model_from": [
      "1",
      0
    ],
    "latent_from": [
      "8",
      0
    ]
  },
  "has_denoise": false
}
